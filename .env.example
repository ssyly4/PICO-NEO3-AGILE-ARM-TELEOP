# External NERO SDK workspace and Python environments
NERO_WS=/home/your-user/nero_ws
NERO_TELEOP_PYTHON=/home/your-user/nero_ws/.venv/bin/python
NERO_LEROBOT_PYTHON=/home/your-user/enter/envs/lerobot/bin/python

# Stable SocketCAN names and physical gs_usb paths from `lsusb -t`
PICO_LEFT_CAN_PORT=can_left
PICO_RIGHT_CAN_PORT=can_right
PICO_LEFT_CAN_USB_BUS=1-2.3:1.0
PICO_RIGHT_CAN_USB_BUS=3-1.2:1.0

# Persistent V4L2 paths; do not use unstable /dev/videoN names
NERO_WORLD_CAMERA=/dev/v4l/by-path/replace-world-camera-video-index0
NERO_LEFT_WRIST_CAMERA=/dev/v4l/by-path/replace-left-wrist-camera-video-index0
NERO_RIGHT_WRIST_CAMERA=/dev/v4l/by-path/replace-right-wrist-camera-video-index0

# Output locations
NERO_BIMANUAL_DATA_DIR=/home/your-user/nero_data/raw/towel_fold

# Unity/Android tools and the host address embedded in the PICO APK
UNITY_EDITOR=/home/your-user/Unity/Hub/Editor/6000.0.80f1/Editor/Unity
ADB=/home/your-user/Android/Sdk/platform-tools/adb
NERO_PICO_HOST=192.168.8.10

# Optional robot-specific Home overrides: seven comma-separated degrees
# NERO_LEFT_HOME_DEG=-30.156019,19.382340,-8.120762,107.970206,-6.658290,-12.953593,51.727847
# NERO_RIGHT_HOME_DEG=27.183993,19.491612,5.759689,107.696200,2.522327,6.487110,52.642158
